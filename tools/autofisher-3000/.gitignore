# Autofisher-3000 — local/build artifacts (this is a PUBLIC repo)

# Rust build output (workspace target/ and any per-crate target/). Cargo.lock IS
# committed — this is an application.
target/

# Portal restore token + ad-hoc frame grabs (machine-specific; a grab may show
# your desktop). Lure-icon templates under bot/icons/ ARE committed.
restore.token
frames/

# Training screenshot corpus: kept locally to retrain the cascades, never
# committed — ~676 MB of full-desktop captures.
training/negative/
training/positive/

# OpenCV traincascade working dirs (intermediate stages / sample dumps)
training/cascade/
training/results/

# YOLO dataset built from the corpus by training/nn/convert_labels.py (symlinks +
# a data.yaml with an absolute path) and Ultralytics training runs. Regenerable;
# the scripts + README under training/nn/ ARE committed.
training/nn/dataset/
training/nn/runs/

# Ultralytics pretrained downloads (yolo11n.pt, yolo26n.pt) + stray run output that
# lands in the working dir when training/exporting. Regenerable. NOTE: the *exported*
# detector bot/models/bobber.onnx IS committed (it ships with the bot).
*.pt
/runs/
