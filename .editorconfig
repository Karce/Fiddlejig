root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: trailing spaces can be meaningful (hard line breaks)
[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Lua indentation is owned by StyLua (see its defaults / an optional stylua.toml)
