{
  "name": "Fiddlejig",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "updateRemoteUserUID": false,
  "remoteUser": "vscode",
  // Claude Code keeps its state (sessions, transcripts, plans, credentials) in
  // ~/.claude. Without this the container filesystem takes it all on every
  // rebuild. A named volume keeps it per-developer and out of the repo.
  "mounts": [
    "source=fiddlejig-claude-state,target=/home/vscode/.claude,type=volume"
  ],
  "postCreateCommand": "bash scripts/setup-luals.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "fish": { "path": "/usr/bin/fish" },
          "bash": { "path": "/bin/bash" }
        }
      },
      "extensions": [
        "anthropic.claude-code",
        "rust-lang.rust-analyzer",
        "sumneko.lua",
        "ketho.wow-api",
        "JohnnyMorganz.stylua",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
